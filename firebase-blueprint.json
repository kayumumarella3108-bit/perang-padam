      "title": "MaterialStokItem",
      "description": "Stock of material item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tanggalMasuk": { "type": "string" },
        "namaMaterial": { "type": "string" },
        "qty": { "type": "number" },
        "satuan": { "type": "string" },
        "keterangan": { "type": "string" },
        "noDokumen": { "type": "string" }
      },
      "required": ["id", "tanggalMasuk", "namaMaterial", "qty", "satuan"]
    },
    "MaterialPemakaianItem": {
      "title": "MaterialPemakaianItem",
